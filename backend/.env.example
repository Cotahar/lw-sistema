PORT=3000
JWT_SECRET=troque-este-valor-para-um-segredo-forte-em-producao
DB_PATH=./data/frotista.db
# Pasta onde ficam as fotos do checklist. Em producao com disco persistente
# (ex.: volume do Railway), aponte para dentro dele - o filesystem do
# container normalmente NAO sobrevive a um novo deploy.
UPLOAD_DIR=./uploads
# Usuario admin criado automaticamente na primeira execucao (banco vazio)
ADMIN_EMAIL=admin@frotista.local
ADMIN_SENHA=admin123
