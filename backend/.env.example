PORT=3000
JWT_SECRET=troque-este-valor-para-um-segredo-forte-em-producao
DB_PATH=./data/frotista.db
# Pasta onde ficam os anexos e as fotos (checklist, abastecimentos). Em producao
# com disco persistente (ex.: volume do Railway), aponte para dentro dele - o
# filesystem do container normalmente NAO sobrevive a um novo deploy.
UPLOAD_DIR=./uploads
# Usuario admin criado automaticamente na primeira execucao (banco vazio)
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@frotista.local
ADMIN_SENHA=admin123

# Backup diario (ver README, "Backups e restauracao"). Padroes: ligado, 3h, 7 diarios + 3 mensais.
# BACKUP_DIARIO=0
# BACKUP_DIR=./data/backups
# BACKUP_HORA=3
# BACKUP_MANTER=7
# BACKUP_MANTER_MENSAL=3

# Copia externa dos backups (S3/R2/B2) - so liga com as 4 primeiras preenchidas.
# BACKUP_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# BACKUP_S3_BUCKET=frottex-backup
# BACKUP_S3_ACCESS_KEY_ID=
# BACKUP_S3_SECRET_ACCESS_KEY=
# BACKUP_S3_REGION=auto

# Restaurar um backup da pasta de backups na proxima subida (apague depois).
# RESTAURAR_BACKUP=frottex-auto-2026-11-02.db

# Roteirizador (barra de progresso da viagem no Painel): distancia da rota origem -> destino do frete e quanto falta
# ate o destino, com perfil de CAMINHAO. Chave gratis em openrouteservice.org. Sem ela a barra simplesmente nao aparece.
# A chave fica so no servidor (nunca no navegador). ROTEIRIZADOR_PROVEDOR=simulado e so para desenvolvimento/testes
# (linha reta x 1,25, nunca use em producao).
# ORS_API_KEY=
# ROTEIRIZADOR_PROVEDOR=ors
